{
  "name": "dsh-plugin-pack",
  "version": "1.0.6",
  "description": "DeepSeek Harness 插件整合包：一键把当前 profile 的第三方插件连依赖和配置导出成 zip（内部每个插件是标准 npm tgz），换机/换 profile 拖进去就能还原。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-plugin-pack": "bin/dsh-plugin-pack.js"
  },
  "files": [
    "lib",
    "bin",
    "client.js",
    "hotload.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backup",
    "export",
    "import",
    "bundle",
    "migration",
    "plugin-manager",
    "tarball"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htrp1486/dsh-plugin-pack.git"
  },
  "bugs": {
    "url": "https://github.com/htrp1486/dsh-plugin-pack/issues"
  },
  "homepage": "https://github.com/htrp1486/dsh-plugin-pack#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale"
      ]
    }
  }
}
